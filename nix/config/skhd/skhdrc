#hyper - k : spotify_player playback volume $(($(spotify_player get key playback | jq '.device.volume_percent')+10))

# Spotify App
hyper - p : osascript -e 'tell application "Music" to playpause'
hyper - o : osascript -e 'tell application "Music" to next track'
hyper - i : osascript -e 'tell application "Music" to previous track'
hyper - j : osascript -e 'tell application "Music" to set sound volume to (sound volume) - 2'
hyper - k : osascript -e 'tell application "Music" to set sound volume to (sound volume) + 2'

# Reload Ipad Notes to obsidian vault (sync)
hyper - s : launchctl kickstart -k gui/$(id -u)/com.obsidian.ipad 

# hyper - s : /usr/bin/automator /Users/admin/Developer/git/scripts/sidecar-toggle.workflow
